{
  "name": "aoa-rwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "bun test --isolate --timeout 60000 packages apps",
    "test:engine": "bun test --isolate --timeout 60000 packages/engine",
    "test:api": "bun test --isolate --timeout 60000 apps/api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:api": "bun run apps/api/dev.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.0"
  }
}
